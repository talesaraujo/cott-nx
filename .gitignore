# Nothing derived from the game is ever committed: its files, the code generated from default.xex, and the
# binaries built from that code.

# --- Game files ---------------------------------------------------------------
assets/
*.xex
*.xexp
*.iso
*.rcf
*.updb
*.out.bin

# --- Generated from the game --------------------------------------------------
generated/
app*/generated/

# --- Third-party sources: fetched by tools/fetch_thirdparty.py ------------------
# Only the files this port changed are tracked (added with git add -f).
sdk/thirdparty/*
!sdk/thirdparty/CMakeLists.txt

# --- Build output -------------------------------------------------------------
out/
build/
*.nro
*.nacp
*.elf
*.o
*.obj
*.a
*.log
*.err

# --- Personal agent notes (see CLAUDE.md) ------------------------------------
CLAUDE.local.md

# --- Tools --------------------------------------------------------------------
__pycache__/
*.pyc
.vs/
.vscode/
.cache/

# --- Run logs -----------------------------------------------------------------
logs/

# Homebrew menu icon made from the game's own art (tools/switch/make_icon.py): game data, never committed.
tools/switch/icon/

# Translation work files (tools/text/export_po.py): they hold the game's English text.
translations/work/
